{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Registry": {
    "Path": "../sample-data/loggers.json"
  },
  "Database": {
    "Path": "fridges.db"
  },
  "Analysis": {
    "LimitC": 5.0,
    "MinExcursionMinutes": 30,
    "TrendWindowHours": 3,
    "TrendWarnCPerHour": 0.5,
    "GapFactor": 2.0
  }
}
