@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (Model.Fleet is null)
{
    <h1>No readings yet</h1>
    <div class="panel">
        <p>Upload the logger files the branch managers emailed, or your combined sheet.</p>
        <div class="actions">
            <a class="button" asp-page="/Upload">Upload files</a>
            <form method="post" asp-page-handler="LoadSample">
                <button class="secondary" type="submit">Load sample week</button>
            </form>
        </div>
        <p class="muted">"Load sample week" imports the made-up files in <code>sample-data/</code>, for trying the app out.</p>
    </div>
}
else
{
    var fridges = Model.Fleet.Fridges;
    var problems = fridges.Where(f => f.Status != FridgeStatus.Ok).ToList();
    var ok = fridges.Where(f => f.Status == FridgeStatus.Ok).ToList();

    <div class="page-head">
        <h1>How every fridge is doing</h1>
        <span class="muted">7 days up to the latest reading, @Fmt.Time(Model.Fleet.AsOf)</span>
    </div>

    <div class="tiles">
        @foreach (var status in Enum.GetValues<FridgeStatus>())
        {
            <div class="tile status-@StatusUi.Css(status)">
                <span class="tile-count">@fridges.Count(f => f.Status == status)</span>
                <span class="tile-label">@StatusUi.Icon(status) @StatusUi.Label(status)</span>
            </div>
        }
    </div>

    @if (problems.Count > 0)
    {
        <h2 class="sr-only">Needs attention</h2>
        <div class="cards">
            @foreach (var f in problems)
            {
                <partial name="_FridgeCard" model="f" />
            }
        </div>
    }

    @if (ok.Count > 0)
    {
        <details class="ok-list" open="@(problems.Count == 0)">
            <summary>@ok.Count fridge@(ok.Count == 1 ? "" : "s") OK</summary>
            <div class="cards">
                @foreach (var f in ok)
                {
                    <partial name="_FridgeCard" model="f" />
                }
            </div>
        </details>
    }

    @if (Model.Fleet.Unassigned.Count > 0)
    {
        var loggers = string.Join(", ", Model.Fleet.Unassigned.Select(r => r.LoggerId).Distinct());
        <p class="muted">
            @Model.Fleet.Unassigned.Count reading(s) from @loggers were taken while the logger wasn't in any fridge
            (for example while being moved). They don't count for any fridge.
        </p>
    }
}
