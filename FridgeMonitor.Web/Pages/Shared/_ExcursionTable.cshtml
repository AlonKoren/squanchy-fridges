@model ExcursionTable
<div class="table-wrap">
    <table>
        <thead>
            <tr><th>From</th><th>Until</th><th class="num">How long</th><th class="num">Peak</th><th>Note</th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Excursions)
        {
            <tr class="@(e.IsBrief ? "brief" : "")">
                <td>@Fmt.Time(e.Start)</td>
                <td>@(e.Ongoing ? $"still above at {Fmt.Time(e.End)}" : Fmt.Time(e.End))</td>
                <td class="num">
                    @Fmt.Duration(e.Duration)@(e.Ongoing ? "+" : "")
                    @if (e.StartedBeforePeriod || e.ContinuedAfterPeriod)
                    {
                        @* Visible on a phone too, where the Note column is off screen. *@
                        <div class="muted">@Fmt.Duration(e.DurationWithin(Model.Range.Start, Model.Range.EndExclusive)) <br />in these dates</div>
                    }
                </td>
                <td class="num">@Fmt.Temp(e.PeakC)</td>
                <td>
                    @if (e.IsBrief) { <span class="tag">Brief (door opening?)</span> }
                    @if (e.IncludesGap) { <span class="tag warn">Includes missing data</span> }
                    @if (e.StartedBeforePeriod) { <span class="tag">Started before this period</span> }
                    @if (e.ContinuedAfterPeriod) { <span class="tag">Continued after this period</span> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
