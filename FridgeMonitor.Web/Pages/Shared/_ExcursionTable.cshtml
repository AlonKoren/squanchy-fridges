@model IEnumerable<Excursion>
<div class="table-wrap">
    <table>
        <tr><th>From</th><th>Until</th><th class="num">How long</th><th class="num">Peak</th><th>Note</th></tr>
        @foreach (var e in Model)
        {
            <tr class="@(e.IsBrief ? "brief" : "")">
                <td>@Fmt.Time(e.Start)</td>
                <td>@(e.Ongoing ? "still above" : Fmt.Time(e.End))</td>
                <td class="num">@Fmt.Duration(e.Duration)@(e.Ongoing ? "+" : "")</td>
                <td class="num">@Fmt.Temp(e.PeakC)</td>
                <td>
                    @(e.IsBrief ? "Brief (door opening?)" : "")
                    @(e.IncludesGap ? "Includes missing data" : "")
                </td>
            </tr>
        }
    </table>
</div>
