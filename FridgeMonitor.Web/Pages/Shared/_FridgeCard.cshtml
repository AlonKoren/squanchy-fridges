@model FridgeReport
@{
    var brief = Model.Excursions.Count(e => e.IsBrief);
}
<a class="card status-@StatusUi.Css(Model.Status)" asp-page="/Fridge" asp-route-branch="@Model.Fridge.Branch" asp-route-fridge="@Model.Fridge.Fridge">
    <div class="card-head">
        <span class="muted">@Model.Fridge.Branch</span>
        <span class="badge status-@StatusUi.Css(Model.Status)">@StatusUi.Label(Model.Status)</span>
    </div>
    <div class="card-title">@Model.Fridge.Fridge</div>
    @if (Model.LastValid is { } last)
    {
        <div><span class="card-temp">@Fmt.Temp(last.TempC!.Value)</span> <span class="muted">at @Fmt.Time(last.Time)</span></div>
    }
    @if (Model.Reasons.Count > 0)
    {
        <ul class="reasons">
            @foreach (var reason in Model.Reasons.OrderBy(r => r.Level))
            {
                <li>@reason.Text</li>
            }
        </ul>
    }
    @if (brief > 0)
    {
        <div class="muted">@brief brief spike@(brief == 1 ? "" : "s") above 5°C (door opening?), not counted as a problem</div>
    }
</a>
